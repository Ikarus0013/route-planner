# Copy this file to .env and fill in your own keys.
# Never commit the .env file.

# TypeSafe AI API key (required). The Jev model reads the trip note and judges each trip.
# Get a key at https://typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# SerpApi key (required for flights and public transit). Uses the Google Flights
# and Google Maps Directions engines. The free plan gives 250 searches each month.
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# Optional TypeSafe SDK settings. The SDK reads these if you set them.
# TYPESAFE_BASE_URL=
# TYPESAFE_DEFAULT_MODEL=
# TYPESAFE_LOG_LEVEL=
